          "listen": "test",
          "script": {
            "exec": [
              "// Valida se o status da resposta é 200 OK\r",
              "pm.test(\"Autenticação realizada com sucesso\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Extrai o token do JSON de resposta e salva na variável de ambiente\r",
              "var jsonData = pm.response.json();\r",
              "if (jsonData.token) {\r",
              "    pm.environment.set(\"authToken\", jsonData.token);\r",
              "    console.log(\"Token atualizado no ambiente:\", jsonData.token);\r",
              "}"
            ],
